# คัดลอกเป็น .env เฉพาะเมื่อแอปไม่ได้อยู่ที่ path มาตรฐาน
# Windows: C:\dev\multi-agent-workshop-hybrid
# Mac/Linux: ~/dev/multi-agent-workshop-hybrid
# ไฟล์ .env ถูก git ignore — อย่า commit
WORKSHOP_DIR=

# คีย์ OpenRouter จากศูนย์ฝึก ตั้งเป็นตัวแปรของเครื่องตาม SETUP.md
# ช่องนี้เว้นว่างได้ ถ้าตั้งตัวแปรของเครื่องแล้ว ห้ามใส่ค่าจริงแล้ว commit
OPENROUTER_API_KEY=

# ต้องว่างเสมอ บัญชี Claude ของคลาสจะถูกคีย์นี้ทับ
ANTHROPIC_API_KEY=

# ชื่อโมเดลบนกระดาน ถ้าศูนย์เปลี่ยนให้แก้ตรงนี้และในไฟล์ตั้งค่า OpenCode ส่วนตัว
OPENCODE_MODEL=openrouter/anthropic/claude-sonnet-4.5

COURSE_ID=VIBE-CODE-L2
CLASS_DATES=2026-11-12,2026-11-13
PROJECT_ID=registry-insight
